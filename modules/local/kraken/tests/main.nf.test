nextflow_process {

    name "Test Process Kraken2"
    script "../main.nf"
    process "KRAKEN"

    test("kraken - stub") {
        options "-stub"

        when {
            process {
                """
                input[0] = Channel.of([
                    [ id: 'test', single_end: true ],
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/fastq/test_1.fastq.gz', checkIfExists: true)
                ])
                input[1] = [] 
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }

    test("kraken single end - real") {
        tag "real"
        when {
            process {
                """
                input[0] = Channel.of([
                    [ id: 'test', single_end: true ],
                    file(params.modules_kraken_data_path + 'K003_Unmapped.out.mate1', checkIfExists: true)
                ])
                input[1] = file(params.kraken_smalldatabase_path, checkIfExists: true)  
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.out.report }
            )
        }
    }

        test("kraken paired end - real") {
        tag "real"
        when {
            process {
                """
                input[0] = Channel.of([
                    [ [ id: 'test', single_end: false ], [ id: 'test2', single_end: true ]]
                    [
                        file(params.modules_kraken_data_path + 'K003_Unmapped.out.mate1', checkIfExists: true),
                        file(params.modules_kraken_data_path + 'K003_Unmapped.out.mate2', checkIfExists: true)
                    ]
                    [
                        file(params.modules_kraken_data_path + 'K004_Unmapped.out.mate1', checkIfExists: true)
                    ]
                ])
                input[1] = file(params.kraken_smalldatabase_path, checkIfExists: true)  
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.out.report }
            )
        }
    }
}

