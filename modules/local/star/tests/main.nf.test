// this should hold the asserts etc to test the output for star is correct
nextflow_process {

    name "Test Process STAR"
    script "../main.nf"
    process "STAR"

    test("Should align paired-end reads") {

        when {
            process {
                """
                input[0] = [
                    [ id: 'test', single_end: false ],
                    [
                        file(params.test_data['reads']['paired']['read_one'], checkIfExists: true),
                        file(params.test_data['reads']['paired']['read_two'], checkIfExists: true)
                    ]
                ]
                input[1] = file(params.test_data['index']['star'], checkIfExists: true)
                """
            }
        }

        then {
            assert process.success
            assert snapshot(process.out).match()
        }
    }

    test("Should align single-end reads") {

        when {
            process {
                """
                input[0] = [
                    [ id: 'test', single_end: true ],
                    [
                        file(params.test_data['reads']['paired']['read_one'], checkIfExists: true)
                    ]
                ]
                input[1] = file(params.test_data['index']['star'], checkIfExists: true)
                """
            }
        }

        then {
            assert process.success
            assert snapshot(process.out).match()
        }
    }
}