nextflow_process {

    name "Test Process STAR"
    script "../main.nf"
    process "STAR"

    test("paired-end reads - stub") {
        options "-stub"

        when {
            process {
                """
                input[0] = Channel.of([
                    [ id: 'test', single_end: false ],
                    [
                        file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/fastq/test_1.fastq.gz', checkIfExists: true),
                        file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/fastq/test_2.fastq.gz', checkIfExists: true)
                    ]
                ])
                input[1] = file(params.star_index, checkIfExists: true) 
                input[2] = file(params.genome_fasta, checkIfExists: true) 
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }

    test("single-end reads - stub") {
        options "-stub"

        when {
            process {
                """
                input[0] = Channel.of([
                    [ id: 'test', single_end: true ],
                    [
                        file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/fastq/test_1.fastq.gz', checkIfExists: true)
                    ]
                ])
                input[1] = file(params.star_index, checkIfExists: true) 
                input[2] = file(params.genome_fasta, checkIfExists: true) 
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }



    test("paired-end reads - real") {
        tag "real"
        when {
            process {
                """
                input[0] = Channel.of([
                    [ id: 'test', single_end: false ],
                    [
                        file('/blue/kgraim/leslie.smith1/Repositories/Sepsis_Metagenomics/nf-core-sepsismetagenomics/assets/test_data/small/' + 'RS010_L001_R1.fastq.gz', checkIfExists: true),
                        file('/blue/kgraim/leslie.smith1/Repositories/Sepsis_Metagenomics/nf-core-sepsismetagenomics/assets/test_data/small/' + 'RS010_L001_R2.fastq.gz', checkIfExists: true)
                    ]
                ])
                input[1] = file(params.star_index, checkIfExists: true) 
                input[2] = file(params.genome_fasta, checkIfExists: true) 
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.out.bam }
                { assert process.out.unmapped_reads}

            )
        }
    }

    test("single-end reads - real") {
        tag "real"
        when {
            process {
                """
                input[0] = Channel.of([
                    [ id: 'test', single_end: true ],
                    [
                        file('/blue/kgraim/leslie.smith1/Repositories/Sepsis_Metagenomics/nf-core-sepsismetagenomics/assets/test_data/small/' + 'RS010_L001_R1.fastq.gz', checkIfExists: true),
                    ]
                ])
                input[1] = file(params.star_index, checkIfExists: true) 
                input[2] = file(params.genome_fasta, checkIfExists: true) 
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.out.bam }
                { assert process.out.unmapped_reads}

            )
        }
    }

}
